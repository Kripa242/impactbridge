# Copy to .env for local overrides (never commit .env).

# Postgres connection string. Leave empty locally to use the embedded PGlite database in ./.data
DATABASE_URL=

# Long random string used to sign session tokens. REQUIRED in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Platform admin account, created on boot if it doesn't exist.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Set to true to load fictional demo organisations into an empty database on boot.
SEED_DEMO=true

# Set to false only if your Postgres host does not support SSL.
PGSSL=

PORT=3000
NODE_ENV=development
